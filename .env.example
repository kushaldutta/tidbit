# Tidbit environment variables.
# Copy to .env and fill in the real values. Restart Expo with `--clear` after editing.

# --- Supabase ---
# Client-side (used by the Expo app). EXPO_PUBLIC_ prefix is required so they
# get inlined at build time. The anon key is safe to ship; RLS policies must
# enforce all per-user access controls.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-side (used by server/index.js). Service role key bypasses RLS, so
# never expose it to the client.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- OAuth providers (configured in the Supabase dashboard) ---
# Google: enable in Authentication > Providers > Google.
# Apple:  enable in Authentication > Providers > Apple. Configure Services ID
#         and redirect URL https://YOUR-PROJECT.supabase.co/auth/v1/callback.

# --- OpenAI (W10: AI deck/quiz generation, snap-a-page) ---
OPENAI_API_KEY=sk-...

# --- RevenueCat (W9: in-app purchases) ---
# Public SDK keys (safe to commit alongside code, but kept here for parity).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# Webhook auth token used by /api/revenuecat-webhook to validate posts.
REVENUECAT_WEBHOOK_AUTH=replace-with-random-string

# --- Server ---
PORT=3000
HOST=0.0.0.0
